# /home/obed/Documents/bootcamp-waitlist/backend/.env.example
# Copy this to .env and fill in real values. Never commit the real .env file.

ENVIRONMENT=development

# Supabase: Project Settings -> Database -> Connection string -> URI
# Swap "postgresql://" prefix for "postgresql+asyncpg://"
DATABASE_URL=postgresql+asyncpg://postgres:YOUR_PASSWORD@YOUR_HOST:5432/postgres

# Comma-separated, NO spaces, NO trailing slash
# Include BOTH localhost (dev) and your production frontend URL
# Example: http://localhost:5173,https://bootcamp-waitlist-zeta.vercel.app
ALLOWED_ORIGINS=http://localhost:5173,https://your-vercel-domain.vercel.app
# Optional regex for Vercel preview deployments and the production custom domain.
ALLOWED_ORIGIN_REGEX=https://.*\.vercel\.app$|https://(www\.)?businessanalysisschool\.com$

ADMIN_API_KEY=generate-a-long-random-string-here

# GoHighLevel private integration — set both values to send waitlist leads to GHL
GHL_PRIVATE_INTEGRATION_TOKEN=your-ghl-private-integration-token
GHL_LOCATION_ID=your-ghl-location-id
